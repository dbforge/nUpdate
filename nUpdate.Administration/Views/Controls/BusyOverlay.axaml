<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:nUpdate.Administration.ViewModels"
             x:Class="nUpdate.Administration.Views.Controls.BusyOverlay"
             x:DataType="vm:DialogViewModel"
             IsVisible="{Binding IsBusy}">
  <Border Background="{DynamicResource OverlayBrush}">
    <Border Classes="card" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20,16" MinWidth="360"
            BoxShadow="{DynamicResource PopupShadow}">
      <StackPanel Spacing="12">
        <TextBlock Name="BusyText" Text="{Binding BusyText}" FontWeight="Medium" />
        <ProgressBar Name="BusyProgress" Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" MinHeight="6"
                     CornerRadius="3" Foreground="{DynamicResource AccentBrush}" />
      </StackPanel>
    </Border>
  </Border>
</UserControl>
