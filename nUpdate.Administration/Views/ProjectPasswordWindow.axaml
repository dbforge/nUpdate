<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:nUpdate.Administration.ViewModels"
        xmlns:c="using:nUpdate.Administration.Views.Controls"
        x:Class="nUpdate.Administration.Views.ProjectPasswordWindow"
        x:DataType="vm:ProjectPasswordViewModel"
        Title="{Binding Title}" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/nUpdate.ico">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bottombar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Name="AcceptButton" Classes="primary" Content="Continue" Command="{Binding AcceptCommand}"
                IsDefault="True" MinWidth="100" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,22,24,20" Spacing="14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Classes="tile" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                Margin="0,0,14,0">
          <c:Icon Data="{StaticResource IconKey}" Width="18" Height="18" />
        </Border>
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="sub"
                     Text="The passwords and the private key can be saved in the project file, encrypted with a project password. The password is remembered on this computer and asked for once on any other." />
        </StackPanel>
      </DockPanel>
      <CheckBox Name="SaveCredentialsBox" Content="Save the credentials in the project file"
                IsChecked="{Binding SaveCredentials}" />
      <StackPanel IsVisible="{Binding SaveCredentials}" Spacing="12">
        <StackPanel>
          <TextBlock Classes="label" Text="Project password (at least 8 characters)" />
          <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Confirm the password" />
          <TextBox Name="ConfirmationBox" Text="{Binding PasswordConfirmation}" PasswordChar="•" />
        </StackPanel>
      </StackPanel>
      <TextBlock Name="ErrorText" Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </DockPanel>
</Window>
