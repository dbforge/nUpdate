<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:nUpdate.Administration.ViewModels"
        xmlns:c="using:nUpdate.Administration.Views.Controls"
        x:Class="nUpdate.Administration.Views.CredentialsWindow"
        x:DataType="vm:CredentialsViewModel"
        Title="{Binding Title}" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/nUpdate.ico">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bottombar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Name="AcceptButton" Classes="primary" Content="Continue" Command="{Binding AcceptCommand}"
                IsDefault="True" MinWidth="100" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,22,24,20" Spacing="14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Classes="tile" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                Margin="0,0,14,0">
          <c:Icon Data="{StaticResource IconLock}" Width="18" Height="18" />
        </Border>
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="sub" Text="The credentials of this project are encrypted with its project password."
                     IsVisible="{Binding AsksForProjectPassword}" />
          <TextBlock Classes="sub" Text="This project does not store its credentials. Enter them for this session."
                     IsVisible="{Binding AsksForSecrets}" />
        </StackPanel>
      </DockPanel>
      <StackPanel IsVisible="{Binding AsksForProjectPassword}" Spacing="10">
        <StackPanel>
          <TextBlock Classes="label" Text="Project password" />
          <TextBox Name="ProjectPasswordBox" Text="{Binding ProjectPassword}" PasswordChar="•" />
        </StackPanel>
        <CheckBox Name="RememberBox" Content="Remember the password on this computer"
                  IsChecked="{Binding RememberPassword}" />
      </StackPanel>
      <StackPanel IsVisible="{Binding AsksForSecrets}" Spacing="12">
        <StackPanel>
          <TextBlock Classes="label" Text="Transfer password" />
          <TextBox Name="TransferPasswordBox" Text="{Binding TransferPassword}" PasswordChar="•" />
        </StackPanel>
        <StackPanel IsVisible="{Binding NeedsSftpPassphrase}">
          <TextBlock Classes="label" Text="SFTP key passphrase" />
          <TextBox Name="SftpPassphraseBox" Text="{Binding SftpKeyPassphrase}" PasswordChar="•" />
        </StackPanel>
        <StackPanel IsVisible="{Binding NeedsProxyPassword}">
          <TextBlock Classes="label" Text="Proxy password" />
          <TextBox Name="ProxyPasswordBox" Text="{Binding ProxyPassword}" PasswordChar="•" />
        </StackPanel>
        <StackPanel IsVisible="{Binding NeedsHttpPassword}">
          <TextBlock Classes="label" Text="HTTP authentication password" />
          <TextBox Name="HttpPasswordBox" Text="{Binding HttpPassword}" PasswordChar="•" />
        </StackPanel>
        <StackPanel IsVisible="{Binding NeedsStatisticsSecret}">
          <TextBlock Classes="label" Text="Statistics admin secret" />
          <TextBox Name="StatisticsSecretBox" Text="{Binding StatisticsAdminSecret}" PasswordChar="•" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Private key (PEM)" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Name="PrivateKeyBox" Text="{Binding PrivateKey}" PasswordChar="•" />
            <Button Grid.Column="1" Name="LoadKeyButton" Command="{Binding LoadPrivateKeyCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{StaticResource IconFolder}" />
                <TextBlock Text="Load from file…" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
      <TextBlock Name="ErrorText" Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </DockPanel>
</Window>
