<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:nUpdate.UpdateInstaller.UI.Avalonia"
        x:Class="nUpdate.UpdateInstaller.UI.Avalonia.InstallerWindow"
        x:DataType="local:InstallerWindowViewModel"
        Title="{Binding Title}" Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Icon="/Assets/nUpdate.ico">
  <!-- The accent: the progress bar and Fluent's accent buttons; the code behind replaces it with the application's. -->
  <Window.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="20,18,20,18">
    <Image Name="IconImage" DockPanel.Dock="Left" Width="48" Height="48" VerticalAlignment="Top" Margin="0,2,16,0" />
    <StackPanel Spacing="8">
      <TextBlock Name="TitleText" Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />

      <StackPanel Spacing="6" IsVisible="{Binding !HasFailed}">
        <TextBlock Name="StatusText" Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        <DockPanel>
          <TextBlock Name="PercentageText" DockPanel.Dock="Right" Text="{Binding PercentageText}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
          <ProgressBar Name="Progress" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="100" Height="8"
                       Foreground="{DynamicResource InstallerAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
        </DockPanel>
      </StackPanel>

      <StackPanel Name="LockedFilePanel" Spacing="10" IsVisible="{Binding IsAskingAboutLockedFile}" Margin="0,6,0,0">
        <TextBlock Name="LockedFileText" Text="{Binding LockedFileMessage}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="RetryButton" Classes="accent" Content="{Binding RetryText}" Command="{Binding RetryCommand}" IsDefault="True" />
          <Button Name="SkipButton" Content="{Binding SkipText}" Command="{Binding SkipCommand}" />
          <Button Name="AbortButton" Content="{Binding AbortText}" Command="{Binding AbortCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Name="ErrorPanel" Spacing="8" IsVisible="{Binding HasFailed}">
        <TextBlock Name="ErrorCaptionText" Text="{Binding ErrorCaption}" FontWeight="SemiBold" Foreground="#C42B1C" TextWrapping="Wrap" />
        <SelectableTextBlock Name="ErrorMessageText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        <SelectableTextBlock Name="LogFileText" Classes="muted" Text="{Binding LogFileText}" TextWrapping="Wrap" FontSize="12"
                             IsVisible="{Binding LogFileText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Name="CloseButton" Classes="accent" Content="{Binding CloseText}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
