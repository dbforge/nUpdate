<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- One source for .NET Framework 4.6.2, which has no ArgumentNullException.ThrowIfNull, and .NET 8. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>true</IsPackable>
    <PackageId>nUpdate.UI.WindowsForms</PackageId>
    <Description>The built-in nUpdate user interface for Windows Forms applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../nUpdate/nUpdate.csproj" />
  </ItemGroup>

</Project>
